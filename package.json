{
  "name": "yup-to-swagger",
  "version": "0.2.0",
  "description": "Convert Yup schemas to OpenAPI 3 Schema Objects (Swagger/OpenAPI definitions)",
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      },
      "require": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      },
      "default": "./dist/main.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/tests.js",
    "test:watch": "node --test --watch test/tests.js",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "yup",
    "openapi",
    "swagger",
    "schema",
    "converter",
    "validation",
    "typescript",
    "esm"
  ],
  "author": "tecfu <help@tecfu.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tecfu/yup2swagger.git"
  },
  "bugs": {
    "url": "https://github.com/tecfu/yup2swagger/issues"
  },
  "homepage": "https://github.com/tecfu/yup2swagger#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "yup": "^1.6.1"
  },
  "peerDependencies": {
    "yup": ">=0.32.0 || >=1.0.0"
  }
}
